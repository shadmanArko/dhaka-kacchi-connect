VITE_API_BASE_URL=http://localhost:8787

# Optional - analytics.ts no-ops safely with this unset, so local dev needs
# no PostHog account. Set it to a real project key to test consent/tracking
# locally.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional - lib/sentry.ts no-ops safely with this unset, so local dev needs
# no Sentry project either. Unlike PostHog, Sentry is NOT gated on the cookie
# banner - it is configured to collect no personal data, see that file's
# header for the reasoning.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# CI-only, and deliberately NOT VITE_-prefixed so they can never be inlined
# into a browser bundle. SENTRY_AUTH_TOKEN + SENTRY_ORG together switch on
# source-map generation and upload in vite.config.ts; with either unset, vite
# emits no maps at all and the build matches a plain local one.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
