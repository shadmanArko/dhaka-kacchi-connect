{
  "name": "dhaka-kacchi-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute dhaka-kacchi --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute dhaka-kacchi --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "worker-mailer": "^1.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.8.3",
    "wrangler": "^3.99.0"
  }
}
