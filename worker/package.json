{
  "name": "dhaka-kacchi-api",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/data && cp src/data/*.json dist/data/",
    "start": "node dist/server.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "digest:weekly": "tsx scripts/weeklyDigest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.8.3"
  }
}
