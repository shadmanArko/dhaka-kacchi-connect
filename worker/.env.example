# Copy to .env for local dev (`cp .env.example .env`, then fill in real
# values). .env is gitignored. Required vars below have no default and the
# process refuses to start without them (see src/config.ts).

# --- Required ---
DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/dhaka_kacchi_ordering
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://dhakakacchi.com,https://www.dhakakacchi.com
ORDER_FROM_EMAIL=orders@dhakakacchi.com

# --- Optional ---
PORT=8787

# The site's own public URL - used only to build the link inside a
# password-reset email. Defaults to the frontend's local dev origin if
# unset, so this never blocks local testing; set it to the real domain
# (e.g. https://dhakakacchi.com) in every deployed environment.
PUBLIC_SITE_URL=http://localhost:8080

# Order-confirmation / password-reset email. Leave blank to skip sending
# order confirmations (order creation still succeeds; sendConfirmationEmail
# just logs a warning and no-ops) - but password-reset emails fall back to
# logging the reset link to the console instead, so that flow stays
# testable locally without real SMTP credentials.
#
# HOSTINGER_SMTP_USER must be the real mailbox (hello@) - orders@ is only a
# free email ALIAS of hello@ on this Hostinger plan (Starter Business Email
# includes just 1 real mailbox), and aliases have no password of their own
# to authenticate SMTP with. ORDER_FROM_EMAIL above stays orders@ though -
# Hostinger's SMTP server accepts sending with a From address that's a
# verified alias of the authenticated mailbox.
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=hello@dhakakacchi.com
HOSTINGER_SMTP_PASS=

# BerlinSMS's plain SMS API - used ONLY for the one-time OTP text at
# registration (see src/lib/berlinSms.ts). This app generates and checks
# the code itself; BerlinSMS just delivers the message. Find this API key
# under "My profile" in the BerlinSMS dashboard - NOT the Website
# key/Secret key pair (those are for BerlinSMS's separate managed 2FA
# product, which doesn't allow a custom message). Leave blank to skip real
# sending - the code is logged to the console instead, so registration
# stays testable locally without a real BerlinSMS account.
BERLIN_SMS_API_KEY=

# Telegram order alerts - replaces the old WhatsApp alert (free vs. paid).
# Create a bot via @BotFather, message it once, then fetch
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
# Leave blank to skip sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Verifies an inbound Telegram webhook request actually came from Telegram
# (see src/lib/telegram.ts / POST /telegram/webhook) - sent back by Telegram
# as the X-Telegram-Bot-Api-Secret-Token header on every webhook call, once
# registered via `npm run telegram:set-webhook`. Generate with, e.g.
# `openssl rand -hex 32`. Leave blank (along with the two vars above) to
# leave the webhook disabled - it 404s until all three are set.
TELEGRAM_WEBHOOK_SECRET=

# Doorstep delivery pricing needs no secret here - it's computed from a
# bundled German postal-code dataset (src/lib/plzLookup.ts), no API/account.

# Sentry error tracking (see src/instrument.ts) - reports uncaught
# exceptions/rejections and everything passed to Sentry.captureException
# across the app. Leave SENTRY_DSN blank to skip entirely (Sentry.init()
# never runs, same "optional integration degrades gracefully" rule as
# everything else above). Get a DSN from a Sentry project's Settings >
# Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Read-only cross-repo connection into the sibling dhaka_kacchi_ai_harness
# warehouse database (see that repo's deploy/postgres-init/
# 01-init-databases.sh for the warehouse_reader role this connects as -
# never warehouse_app). Powers ONLY the admin reporting page (src/lib/
# reportingRepository.ts, GET /v1/admin/reporting) - leave blank to skip:
# that one route answers 503, nothing else in this app is affected. In
# production this is composed automatically in docker-compose.yml from
# WAREHOUSE_READER_PASSWORD - only set it directly here for local dev, and
# only if you're actually working on the reporting page.
WAREHOUSE_DATABASE_URL=

# A THIRD, narrower cross-repo connection into the same warehouse database,
# as warehouse_cockpit_writer (SELECT+UPDATE-only on cockpit_alert, never
# SELECT-everything like warehouse_reader above). Powers ONLY the admin cockpit
# page's acknowledge/resolve actions (src/lib/cockpitRepository.ts, PATCH
# /v1/admin/cockpit/alerts/:id/{acknowledge,resolve}) - leave blank to skip:
# those two routes answer 503, nothing else is affected. Same local-dev-
# only note as WAREHOUSE_DATABASE_URL above.
WAREHOUSE_COCKPIT_DATABASE_URL=
