# Copy to .env for local dev (`cp .env.example .env`, then fill in real
# values). .env is gitignored. Required vars below have no default and the
# process refuses to start without them (see src/config.ts).

# --- Required ---
DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/dhaka_kacchi_ordering
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://dhakakacchi.com,https://www.dhakakacchi.com
ORDER_FROM_EMAIL=orders@dhakakacchi.com

# --- Optional ---
PORT=8787

# The site's own public URL - used only to build the link inside a
# password-reset email. Defaults to the frontend's local dev origin if
# unset, so this never blocks local testing; set it to the real domain
# (e.g. https://dhakakacchi.com) in every deployed environment.
PUBLIC_SITE_URL=http://localhost:8080

# Order-confirmation / password-reset email. Leave blank to skip sending
# order confirmations (order creation still succeeds; sendConfirmationEmail
# just logs a warning and no-ops) - but password-reset emails fall back to
# logging the reset link to the console instead, so that flow stays
# testable locally without real SMTP credentials.
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=orders@dhakakacchi.com
HOSTINGER_SMTP_PASS=

# BerlinSMS's plain SMS API - used ONLY for the one-time OTP text at
# registration (see src/lib/berlinSms.ts). This app generates and checks
# the code itself; BerlinSMS just delivers the message. Find this API key
# under "My profile" in the BerlinSMS dashboard - NOT the Website
# key/Secret key pair (those are for BerlinSMS's separate managed 2FA
# product, which doesn't allow a custom message). Leave blank to skip real
# sending - the code is logged to the console instead, so registration
# stays testable locally without a real BerlinSMS account.
BERLIN_SMS_API_KEY=

# Telegram order alerts - replaces the old WhatsApp alert (free vs. paid).
# Create a bot via @BotFather, message it once, then fetch
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id.
# Leave blank to skip sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Doorstep delivery pricing needs no secret here - it's computed from a
# bundled German postal-code dataset (src/lib/plzLookup.ts), no API/account.
