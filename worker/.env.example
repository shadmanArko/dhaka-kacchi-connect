# Copy to .env for local dev (`cp .env.example .env`, then fill in real
# values). .env is gitignored. Required vars below have no default and the
# process refuses to start without them (see src/config.ts).

# --- Required ---
DATABASE_URL=postgresql://YOUR_USER@127.0.0.1:5432/dhaka_kacchi_ordering
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://dhakakacchi.de,https://www.dhakakacchi.de
ORDER_FROM_EMAIL=orders@dhakakacchi.de

# --- Optional ---
PORT=8787

# Order-confirmation email. Leave blank to skip sending (order creation
# still succeeds; sendConfirmationEmail just logs a warning and no-ops).
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=orders@dhakakacchi.de
HOSTINGER_SMTP_PASS=

# WhatsApp order alert (Twilio). Leave blank to skip sending, same as above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
ARKO_WHATSAPP_TO=

# Doorstep delivery pricing needs no secret here - it's computed from a
# bundled German postal-code dataset (src/lib/plzLookup.ts), no API/account.
